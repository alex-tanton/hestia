From 2344443972fc86a9120376bc8934b34f6e0d0362 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 21 Oct 2026 17:49:52 +0000
Subject: [PATCH 3/3] ci: watch the setup action and drop two spec citations

- Dependabot's github-actions entry now scans / and /.github/actions/setup, so the two actions
  that moved into the composite keep getting weekly bumps (Pitfall 10).
- The comments above deploy.yml's `changes` step and ci.yml's `pnpm test:e2e` state their rule
  without citing a retired spec document (D-09, D-10). The parsed YAML is unchanged.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01MqJ2Cux3rut83bCEjam9rE
---
 .github/dependabot.yml       | 2 +-
 .github/workflows/ci.yml     | 2 +-
 .github/workflows/deploy.yml | 4 ++--
 3 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/.github/dependabot.yml b/.github/dependabot.yml
index c228d70..a3aab73 100644
--- a/.github/dependabot.yml
+++ b/.github/dependabot.yml
@@ -11,7 +11,7 @@ updates:
       prefix: build
 
   - package-ecosystem: github-actions
-    directory: /
+    directories: ['/', '/.github/actions/setup']
     schedule:
       interval: weekly
     groups:
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index b671dfd..5310d2b 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -104,7 +104,7 @@ jobs:
       # BuildKit `# syntax=` frontend. The logins above make the pulls authenticated where possible.
       - run: bash scripts/ci-prepull-images.sh
       # Exactly the local command: Playwright's global setup builds and starts the stack from an
-      # empty database, and its teardown drops it (Engineering Practices, "E2E environment").
+      # empty database, and its teardown drops it.
       - run: pnpm test:e2e
       - uses: actions/upload-artifact@v7
         if: failure()
diff --git a/.github/workflows/deploy.yml b/.github/workflows/deploy.yml
index 0dc0566..f74f813 100644
--- a/.github/workflows/deploy.yml
+++ b/.github/workflows/deploy.yml
@@ -28,8 +28,8 @@ jobs:
         with:
           ref: ${{ github.event.workflow_run.head_sha }}
           fetch-depth: 2
-      # Engineering Practices: a change touching only docs/ is not deployed. main is
-      # squash-merged, so each push is one commit.
+      # A change touching only docs/ is not deployed. main is squash-merged, so each push is
+      # one commit.
       - id: changes
         run: |
           if git diff --name-only HEAD~1 HEAD | grep -qv '^docs/'; then
-- 
