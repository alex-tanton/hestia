{
  "name": "@hearth/service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "hearth-admin": "bin/hearth-admin"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup && tsx src/write-openapi.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ../../supabase/seed",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --config vitest.coverage.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:types": "kysely-codegen --dialect postgres --url \"${HEARTH_DB_ADMIN_URL:-postgresql://postgres:postgres@127.0.0.1:54322/postgres}\" --include-pattern \"public.*\" --date-parser string --out-file src/db/types.ts && prettier --write src/db/types.ts",
    "db:seed": "tsx ../../supabase/seed/seed-users.ts",
    "fixtures:normalize": "tsx scripts/normalize-fixtures.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.1",
    "@hearth/matching": "workspace:*",
    "@hearth/recurrence": "workspace:*",
    "@hearth/shared": "workspace:*",
    "cheerio": "1.2.0",
    "fastify": "5.12.7",
    "kysely": "0.29.6",
    "node-cron": "4.6.0",
    "parse-ingredient": "3.0.0",
    "pg": "8.23.1",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.4",
    "kysely-codegen": "0.20.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
