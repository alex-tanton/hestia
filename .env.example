# Hestia host configuration. Never commit the real file.
#
# The real .env lives OUTSIDE the repository checkout, at /srv/hestia/.env by default, because
# the deploy runner's checkout is wiped on every run. Create it with:
#   scripts/generate-secrets.sh            # writes /srv/hestia/.env, refuses to overwrite
# then fill in the three non-secret values below.

# The pinned public origin, https://<machine>.<tailnet>.ts.net. It is baked into every installed
# PWA and push subscription: it must never change; see docs/deployment.md, "Pinned names".
HESTIA_ORIGIN=https://<machine>.<tailnet>.ts.net

# The server owner's sign-in email; unlocks System health.
HESTIA_OWNER_EMAIL=owner@example.com

# Magic link needs a domain and an SMTP relay. The caddy image
# build turns this into VITE_MAGIC_LINK_ENABLED, so the PWA follows it from the next deploy.
HESTIA_MAGIC_LINK_ENABLED=false

# Backup directory on the second physical disk. Mounted into the backup container, and
# read-only into hestia-service.
BACKUP_DIR=/mnt/backup/hestia

# Optional. Per-IP requests per minute across /api. Leave
# it unset in production: the default is 300, and only the E2E overlay raises it.
# HESTIA_RATE_LIMIT_PER_MINUTE=300

# --- Generated by scripts/generate-secrets.sh ---

# Postgres superuser password; also used by GoTrue (supabase_auth_admin), Realtime, and backups.
POSTGRES_PASSWORD=<generated>

# Password for hestia_service, the login role the service connects as.
HESTIA_SERVICE_DB_PASSWORD=<generated>

# GoTrue's HS256 JWT secret, and the anon and service-role keys signed with it.
JWT_SECRET=<generated>
ANON_KEY=<generated>
SERVICE_ROLE_KEY=<generated>

# Realtime's cookie-signing secret and its 16-character tenant-credential encryption key.
REALTIME_SECRET_KEY_BASE=<generated>
REALTIME_DB_ENC_KEY=<generated>

# Web Push VAPID key pair (P-256, base64url, as the web-push library expects).
VAPID_PUBLIC_KEY=<generated>
VAPID_PRIVATE_KEY=<generated>
