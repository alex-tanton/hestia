--- a/e2e/tests/08-caddy-refuses-gotrue-endpoints.spec.ts
+++ b/e2e/tests/08-caddy-refuses-gotrue-endpoints.spec.ts
@@ -68,3 +68,75 @@ test('the refusal is method-restricted, so sign-in still reaches GoTrue', async
   const token = await accessToken(request, SEED.alex.email);
