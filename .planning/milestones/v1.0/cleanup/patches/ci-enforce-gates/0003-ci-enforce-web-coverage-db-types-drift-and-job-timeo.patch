From dc55e6570bd4f869d5820368b5801d4396c1bc1a Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 23 Oct 2026 19:40:53 +0000
Subject: [PATCH 3/6] ci: enforce web coverage, db types drift and job timeouts

- test-unit runs the harness, every workspace but web, then web with coverage
- test-integration fails when pnpm db:types changes types.ts, before any test
- timeouts on every job and no persisted token on any checkout

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SMdgjb52uEVQdK1fhxdcUh
---
 .github/workflows/ci.yml | 36 +++++++++++++++++++++++++++++++++++-
 1 file changed, 35 insertions(+), 1 deletion(-)

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 6074594..e650baf 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -13,33 +13,56 @@ concurrency:
   cancel-in-progress: ${{ github.event_name == 'pull_request' }}
 
 # Every job runs on GitHub-hosted runners. The self-hosted runner only ever runs deploy.yml.
+#
+# Every job has a timeout, so a hung step fails in minutes instead of holding a runner for the
+# six-hour default. Each is about two to three times the p95 of the 40 most recent runs (324 job
+# records, 2026-10-13 to 2026-10-22), with a floor of 10 minutes; hygiene is new and has no history.
+# No job fetches or pushes after checkout, so every checkout drops its token with
+# `persist-credentials: false` instead of leaving it in .git/config for the rest of the job.
 jobs:
   lint:
     runs-on: ubuntu-latest
+    timeout-minutes: 10
     steps:
       - uses: actions/checkout@v7
+        with:
+          persist-credentials: false
       - uses: ./.github/actions/setup
       - run: pnpm lint
       - run: pnpm format:check
 
   typecheck:
     runs-on: ubuntu-latest
+    timeout-minutes: 10
     steps:
       - uses: actions/checkout@v7
+        with:
+          persist-credentials: false
       - uses: ./.github/actions/setup
       - run: pnpm typecheck
 
   test-unit:
     runs-on: ubuntu-latest
+    timeout-minutes: 15
     steps:
       - uses: actions/checkout@v7
+        with:
+          persist-credentials: false
       - uses: ./.github/actions/setup
-      - run: pnpm test
+      - run: pnpm test:harness
+      # Web runs once, with coverage, so its thresholds in apps/web/vite.config.ts gate every pull
+      # request. The sweep (sweep.yml) keeps web's plain `test` script, so coverage is not paid for
+      # in every time zone.
+      - run: pnpm -r --filter '!@hearth/web' test
+      - run: pnpm --filter @hearth/web test:coverage
 
   test-integration:
     runs-on: ubuntu-latest
+    timeout-minutes: 25
     steps:
       - uses: actions/checkout@v7
+        with:
+          persist-credentials: false
       - uses: ./.github/actions/setup
       - uses: supabase/setup-cli@v3
         with:
@@ -47,6 +70,12 @@ jobs:
       # Applies supabase/migrations/ to a fresh local stack, the database the tests run against.
       - name: Start Supabase
         run: supabase start
+      # Runs before any test, so the database holds only the migrated schema: a hand edit of
+      # types.ts, or a migration without regenerated types, fails here.
+      - name: db:types matches the migrated schema
+        run: |
+          pnpm db:types
+          git diff --exit-code -- apps/service/src/db/types.ts
       # Runs unit and integration tests together with coverage, enforcing
       # apps/service/vitest.coverage.config.ts's thresholds, rather than a separate job that would
       # pay for its own `supabase start`.
@@ -66,6 +95,8 @@ jobs:
       DOCKERHUB_USERNAME: ${{ secrets.DOCKERHUB_USERNAME }}
     steps:
       - uses: actions/checkout@v7
+        with:
+          persist-credentials: false
       - uses: ./.github/actions/setup
       # The suite's own stack is the Compose stack, so migrations are applied with the CLI the
       # way a deploy applies them, and seeding needs psql (both preinstalled on the runner).
@@ -115,8 +146,11 @@ jobs:
 
   build:
     runs-on: ubuntu-latest
+    timeout-minutes: 10
     steps:
       - uses: actions/checkout@v7
+        with:
+          persist-credentials: false
       - uses: ./.github/actions/setup
       - run: pnpm build
 
