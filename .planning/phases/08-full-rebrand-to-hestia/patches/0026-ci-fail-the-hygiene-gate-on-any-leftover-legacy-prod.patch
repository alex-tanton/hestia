+      'legacy name in .planning/ROADMAP.md:1',
+      'legacy name in .planning/STATE.md:2',
+    ]);
+    assert.match(run.stdout, /^repo-hygiene: 3 problems$/m);
+  });
+
+  it('skips binary files', () => {
+    const repo = newRepo();
+    stageRaw(
+      repo,
+      'image.bin',
