{
  "name": "hestia",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm test:harness && pnpm -r test",
    "test:harness": "node --test test/clock-setup.test.mjs test/global-tz.test.mjs scripts/test-sweep.test.mjs test/eslint-clock-ban.test.mjs test/eslint-service-role-fence.test.mjs scripts/deploy.test.mjs scripts/caddy-entrypoint.test.mjs scripts/ci-prepull-images.test.mjs scripts/check-knip-baseline.test.mjs scripts/check-repo-hygiene.test.mjs scripts/check-migrations-append-only.test.mjs scripts/audit-prod.test.mjs scripts/jscpd-config.test.mjs scripts/deploy-gate.test.mjs",
    "test:integration": "pnpm -r --if-present test:integration",
    "test:sweep": "node scripts/test-sweep.mjs",
    "test:sweep:integration": "node scripts/test-sweep.mjs --suite integration",
    "db:types": "pnpm --filter @hestia/service db:types",
    "db:seed": "pnpm --filter @hestia/service db:seed",
    "fixtures:normalize": "pnpm --filter @hestia/service fixtures:normalize",
    "hestia-admin": "pnpm --filter @hestia/service exec hestia-admin",
    "test:e2e": "pnpm --filter @hestia/e2e test:e2e",
    "build": "pnpm -r --if-present build",
    "jscpd": "jscpd --fail-on-empty",
    "knip": "knip",
    "knip:production": "knip --production --workspace \"!e2e\" --workspace \"!supabase/seed\"",
    "knip:summary": "node scripts/knip-summary.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "jscpd": "5.4.1",
    "knip": "6.41.0",
    "lint-staged": "17.5.1",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.2",
      "ip-address": "10.7.4",
      "undici@7": "7.30.1",
      "fast-uri@4": "4.2.3",
      "fast-uri@3": "3.1.9"
    }
  }
}
