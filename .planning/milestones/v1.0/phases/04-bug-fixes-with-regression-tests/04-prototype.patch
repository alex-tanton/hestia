+/*
+ * Probes for the service-role fence in `eslint.config.js`: outside `main.ts`, `cli.ts`, tests, and
+ * `apps/service/src/privileged/`, a module may not import from `privileged/` (the only code that
+ * builds a `service_role` client, which bypasses RLS), statically or with `import('...')`. Each
+ * probe is a snippet linted under a path in the service tree with the repo's real config. A bad
+ * probe must raise the fence at error severity; a good one must not. Run by `pnpm test` through
+ * the root `test:harness` script.
+ *
+ * Out of reach of the fence, so not probed and not claimed: a dynamic import whose specifier is a
+ * variable or template literal, `require`, a raw `set local role service_role` in SQL, and code
+ * outside `apps/service/src`. `docs/testing.md` lists the same limits.
+ */
+
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+import { ESLint } from 'eslint';
+import tseslint from 'typescript-eslint';
+import { REPO_ROOT } from './support/vitest-project.mjs';
+
+// The probes are virtual files, which the type-aware project service cannot find; the fence reads
+// syntax only, so type information is switched off for them.
+const eslint = new ESLint({
+  cwd: REPO_ROOT,
+  overrideConfig: tseslint.config(tseslint.configs.disableTypeChecked),
+});
+
+const FENCE_RULES = new Set(['@typescript-eslint/no-restricted-imports', 'no-restricted-syntax']);
+
+/** The fence's reports for `code` linted as if it lived at `filePath`. */
+async function fenceMessages(code, filePath) {
+  const [result] = await eslint.lintText(code, { filePath });
+  assert.ok(result, 'no lint result');
+  const fatal = result.messages.filter((message) => message.fatal);
+  assert.deepEqual(fatal, [], `the probe did not parse: ${JSON.stringify(fatal)}`);
+  return result.messages.filter((message) => FENCE_RULES.has(message.ruleId));
+}
+
+const SERVICE_MODULE = 'apps/service/src/routes/probe.ts';
+
+const BAD = [
+  "import { withServiceRoleDb } from '../privileged/service-role-db.js';",
+  "import { createJobDatabase } from '../privileged/job-database.js';",
+  "import * as admin from '../../privileged/gotrue-admin.js';",
+  "import '../privileged/service-role-db.js';",
+  "export { readSystemHealth } from '../privileged/service-role-db.js';",
+  "export * from '../privileged/service-role-db.js';",
+  // A type-only import is allowed; one value beside it is not.
+  "import { type SystemHealthRow, readSystemHealth } from '../privileged/service-role-db.js';",
+  // no-restricted-imports sees static imports only.
+  "const loaded = await import('../privileged/service-role-db.js');",
+  "void import('../privileged/notification-outbox.js').then(() => undefined);",
+];
+
+const GOOD = [
+  "import type { SystemHealthRow } from '../privileged/service-role-db.js';",
+  "import { type SystemHealthRow } from '../privileged/service-role-db.js';",
+  "import { fail } from '../problem.js';",
+  "const loaded = await import('../problem.js');",
+];
+
+describe('service-role fence: imports the fence must report', () => {
+  for (const code of BAD) {
+    it(code, async () => {
+      const messages = await fenceMessages(code, SERVICE_MODULE);
+      assert.ok(messages.length >= 1, 'not reported');
+      assert.ok(
+        messages.every((message) => message.severity === 2),
+        'reported below error severity',
+      );
+    });
+  }
+});
+
+describe('service-role fence: imports it must leave alone', () => {
+  for (const code of GOOD) {
+    it(code, async () => {
+      assert.deepEqual(await fenceMessages(code, SERVICE_MODULE), []);
+    });
+  }
+});
+
+describe('service-role fence: where it applies', () => {
+  const value = "import { withServiceRoleDb } from '../privileged/service-role-db.js';";
+
+  // Every directory of the service, including the files the audit named (routes/users.ts,
+  // http/context.ts).
+  const fenced = [
+    'apps/service/src/routes/users.ts',
+    'apps/service/src/http/context.ts',
+    'apps/service/src/services/lists.ts',
+    'apps/service/src/jobs/scheduler.ts',
+    'apps/service/src/db/user-db.ts',
+    'apps/service/src/app.ts',
+    'apps/service/src/env.ts',
+    'apps/service/src/push/test-seam.ts',
+  ];
+  for (const filePath of fenced) {
+    it(`${filePath} is fenced`, async () => {
+      assert.ok((await fenceMessages(value, filePath)).length >= 1, 'not covered');
+    });
+  }
+
+  // The sanctioned callers.
+  const exempt = [
+    'apps/service/src/main.ts',
+    'apps/service/src/cli.ts',
+    'apps/service/src/privileged/probe.ts',
+    'apps/service/src/privileged/nested/probe.ts',
+    'apps/service/src/routes/probe.test.ts',
+    'apps/service/src/probe.integration.test.ts',
+    'apps/service/src/test/probe.ts',
+  ];
+  for (const filePath of exempt) {
+    it(`${filePath} may import privileged/`, async () => {
+      assert.deepEqual(await fenceMessages(value, filePath), []);
+    });
+  }
+});
diff --git a/test/kong-routes.test.mjs b/test/kong-routes.test.mjs
new file mode 100644
index 0000000..15ddd27
--- /dev/null
+++ b/test/kong-routes.test.mjs
@@ -0,0 +1,223 @@
+/*
+ * Static checks on `docker/kong.yml`, the declarative config for the gateway in front of GoTrue.
+ * GoTrue is an allowlist (Technical Architecture, "Routing"): each call the browser makes has a
+ * route with its method, and everything else under /auth/v1 ends at one refusing route. This test
+ * pins that table exactly, so a route added, a method widened, or an ACL group added fails here
+ * before it reaches a host. It cannot start Kong; `e2e/tests/08-caddy-refuses-gotrue-endpoints
+ * .spec.ts` and the sign-in journeys prove the running gateway behaves as this file says.
+ * Run by `pnpm test` through the root `test:harness` script.
+ */
+
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { describe, it } from 'node:test';
+import { parse } from 'yaml';
+import { REPO_ROOT } from './support/vitest-project.mjs';
+
+const kong = parse(readFileSync(join(REPO_ROOT, 'docker', 'kong.yml'), 'utf8'));
+const compose = parse(readFileSync(join(REPO_ROOT, 'docker', 'docker-compose.yml'), 'utf8'));
+
+/** Every route with the service and plugins it hangs off, flattened. */
+const routes = kong.services.flatMap((service) =>
+  (service.routes ?? []).map((route) => ({
+    name: route.name,
+    upstream: service.url,
+    methods: [...(route.methods ?? [])].sort(),
+    paths: route.paths ?? [],
+    stripPath: route.strip_path,
+    plugins: Object.fromEntries(
+      (service.plugins ?? []).map((plugin) => [plugin.name, plugin.config]),
+    ),
+  })),
+);
+
+const gotrue = routes.filter((route) => route.paths.some((path) => /^~?\/auth\/v1/.test(path)));
+
+const KEYED = { 'key-auth': { hide_credentials: false } };
+const aclOf = (...allow) => ({ acl: { hide_groups_header: true, allow } });
+
+// The whole GoTrue surface Kong exposes. Each upstream is the one GoTrue path the route serves.
+const ALLOWED = [
+  ['auth-v1-verify', 'http://auth:9999/verify', ['GET', 'POST'], '~/auth/v1/verify/?$', {}],
+  [
+    'auth-v1-token',
+    'http://auth:9999/token',
+    ['POST'],
+    '~/auth/v1/token/?$',
+    { ...KEYED, ...aclOf('admin', 'anon') },
+  ],
+  [
+    'auth-v1-logout',
+    'http://auth:9999/logout',
+    ['POST'],
+    '~/auth/v1/logout/?$',
+    { ...KEYED, ...aclOf('admin', 'anon') },
+  ],
+  [
+    'auth-v1-user',
+    'http://auth:9999/user',
+    ['GET'],
+    '~/auth/v1/user/?$',
+    { ...KEYED, ...aclOf('admin', 'anon') },
+  ],
+  [
+    'auth-v1-otp',
+    'http://auth:9999/otp',
+    ['POST'],
+    '~/auth/v1/otp/?$',
+    { ...KEYED, ...aclOf('admin', 'anon') },
+  ],
+  [
+    'auth-v1-admin-users',
+    'http://auth:9999/admin/users',
+    ['GET', 'POST'],
+    '~/auth/v1/admin/users/?$',
+    { ...KEYED, ...aclOf('admin') },
+  ],
+];
+const DENIED = [
+  'auth-v1-denied',
+  'http://auth:9999/',
+  [],
+  '/auth/v1',
+  {
+    'request-termination': { status_code: 403, message: 'Access is forbidden.' },
+  },
+];
+
+describe('kong.yml: the GoTrue allowlist', () => {
+  it('declares format 3.0, which regex paths need', () => {
+    assert.equal(kong._format_version, '3.0');
+  });
+
+  it('has exactly the allowed routes, methods, auth and refusal', () => {
+    const shape = (route) => [
+      route.name,
+      route.upstream,
+      route.methods,
+      route.paths.join(),
+      route.plugins,
+    ];
+    assert.deepEqual(
+      gotrue.map(shape),
+      [...ALLOWED, DENIED].map(([name, upstream, methods, path, plugins]) => [
+        name,
+        upstream,
+        methods,
+        path,
+        plugins,
+      ]),
+    );
+  });
+
+  it('gives every allowed route a method, an exact path, and a path-stripped upstream', () => {
+    for (const route of gotrue.filter((one) => one.name !== DENIED[0])) {
+      assert.ok(route.methods.length > 0, `${route.name} has no methods`);
+      assert.ok(
+        route.paths.every((path) => path.startsWith('~/') && path.endsWith('$')),
+        `${route.name} path is not an exact regex`,
+      );
+      assert.equal(route.stripPath, true, `${route.name} must strip its path`);
+      assert.ok(
+        route.upstream.startsWith('http://auth:9999/') &&
+          route.upstream.length > 'http://auth:9999/'.length,
+      );
+    }
+  });
+
+  it('keeps /verify open and everything else key-authenticated', () => {
+    for (const route of gotrue) {
+      const open = route.name === 'auth-v1-verify' || route.name === DENIED[0];
+      assert.equal('key-auth' in route.plugins, !open, route.name);
+    }
+  });
+
+  it('never lets the anon key reach admin', () => {
+    const admin = gotrue.find((route) => route.name === 'auth-v1-admin-users');
+    assert.deepEqual(admin?.plugins['acl']?.allow, ['admin']);
+  });
+
+  it('leaves the realtime routes alone', () => {
+    const realtime = routes.filter((route) =>
+      route.paths.some((path) => path.startsWith('/realtime/v1')),
+    );
+    assert.deepEqual(
+      realtime.map((route) => [route.name, route.paths.join()]),
+      [
+        ['realtime-v1-ws', '/realtime/v1/'],
+        ['realtime-v1-rest', '/realtime/v1/api'],
+        ['realtime-v1-rest-tenants', '/realtime/v1/api/tenants'],
+        ['realtime-v1-rest-openapi', '/realtime/v1/api/openapi'],
+      ],
+    );
+  });
+
+  it('only uses plugins the Compose file enables', () => {
+    const enabled = new Set(String(compose.services.kong.environment.KONG_PLUGINS).split(','));
+    const used = new Set(routes.flatMap((route) => Object.keys(route.plugins)));
+    for (const plugin of used) assert.ok(enabled.has(plugin), `${plugin} is not in KONG_PLUGINS`);
+  });
+});
+
+// What Kong would do with a request, for the calls below: a route whose regex path and method both
+// match wins over the refusing prefix route. This models the router for this file only; the E2E
+// probes are the proof against the real thing.
+function decide(method, path) {
+  const hit = gotrue.find(
+    (route) =>
+      route.name !== DENIED[0] &&
+      route.methods.includes(method) &&
+      route.paths.some((pattern) => new RegExp(`^${pattern.slice(1)}`).test(path)),
+  );
+  return hit?.name ?? (path.startsWith('/auth/v1') ? DENIED[0] : 'no route');
+}
+
+describe('kong.yml: the calls the browser makes', () => {
+  // supabase-js 2.116.0 (auth-js GoTrueClient / GoTrueAdminApi), as apps/web/src/lib/auth uses it.
+  const CALLS = [
+    ['POST', '/auth/v1/token', 'signInWithPassword, refreshSession, auto refresh', 'auth-v1-token'],
+    ['POST', '/auth/v1/logout', 'signOut (any scope)', 'auth-v1-logout'],
+    [
+      'GET',
+      '/auth/v1/user',
+      'setSession after /api/signup; the URL-fragment sign-in',
+      'auth-v1-user',
+    ],
+    ['GET', '/auth/v1/verify', 'the recovery email link', 'auth-v1-verify'],
+    ['POST', '/auth/v1/verify', 'verifyOtp (magic link)', 'auth-v1-verify'],
+    ['POST', '/auth/v1/otp', 'signInWithOtp (magic link)', 'auth-v1-otp'],
+    ['POST', '/auth/v1/admin/users', 'the E2E seed creating a user', 'auth-v1-admin-users'],
+    ['GET', '/auth/v1/admin/users', 'the E2E seed listing users', 'auth-v1-admin-users'],
+  ];
+  for (const [method, path, because, route] of CALLS) {
+    it(`${method} ${path} (${because}) reaches ${route}`, () => {
+      assert.equal(decide(method, path), route);
+    });
+  }
+
+  const REFUSED = [
+    ['POST', '/auth/v1/signup'],
+    ['PUT', '/auth/v1/user'],
+    ['POST', '/auth/v1/recover'],
+    ['GET', '/auth/v1/settings'],
+    ['GET', '/auth/v1/.well-known/jwks.json'],
+    ['GET', '/auth/v1/health'],
+    ['GET', '/auth/v1/authorize'],
+    ['POST', '/auth/v1/invite'],
+    ['POST', '/auth/v1/admin/generate_link'],
+    ['GET', '/auth/v1/admin/users/00000000-0000-4000-8000-000000000000'],
+    ['PUT', '/auth/v1/admin/users'],
+    ['GET', '/auth/v1/token'],
+    ['PUT', '/auth/v1/token'],
+    ['DELETE', '/auth/v1/logout'],
+    ['POST', '/auth/v1/user'],
+    ['GET', '/auth/v1/'],
+    ['GET', '/auth/v1'],
+  ];
+  for (const [method, path] of REFUSED) {
+    it(`${method} ${path} is refused`, () => {
+      assert.equal(decide(method, path), DENIED[0]);
+    });
+  }
+});
