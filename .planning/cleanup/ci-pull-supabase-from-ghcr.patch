From d25d8e66617b7bc12310c969e92d5593af6cee3d Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 20 Oct 2026 23:55:03 +0000
Subject: [PATCH 2/2] ci: log in to GHCR and Docker Hub before the E2E pulls

test-e2e now has job-level contents: read and packages: read permissions, and logs in to ghcr.io
with the run's own token before the image pre-pull.

An optional Docker Hub login runs only when the DOCKERHUB_USERNAME and DOCKERHUB_TOKEN secrets
exist, so forks, Dependabot and repositories without them skip it.

Both logins use continue-on-error: the images are public and the script falls back to
public.ecr.aws, so a failed or misconfigured login must not fail the job before the fallback runs.

No other job changes.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HxsZ7tmGHEy4wbta427fyF
---
 .github/workflows/ci.yml | 29 ++++++++++++++++++++++++++++-
 1 file changed, 28 insertions(+), 1 deletion(-)

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index c1037db..1948ff5 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -78,6 +78,12 @@ jobs:
     if: github.event_name == 'pull_request' || github.ref == 'refs/heads/main'
     runs-on: ubuntu-latest
     timeout-minutes: 40
+    permissions:
+      contents: read
+      packages: read
+    env:
+      # The `secrets` context cannot be read in a step `if:`, so the job env carries the name.
+      DOCKERHUB_USERNAME: ${{ secrets.DOCKERHUB_USERNAME }}
     steps:
       - uses: actions/checkout@v7
       - uses: pnpm/action-setup@v6
@@ -92,6 +98,27 @@ jobs:
         with:
           version: 2.117.0
       - run: pnpm --filter @hearth/e2e exec playwright install --with-deps chromium
+      # GHCR pulls run as this run's own read-only token instead of anonymously. The images are
+      # public, so anonymous pulls work too: a failed login must not fail the job before the
+      # script's public.ecr.aws fallback can run.
+      - name: Log in to ghcr.io
+        continue-on-error: true
+        uses: docker/login-action@v4
+        with:
+          registry: ghcr.io
+          username: ${{ github.actor }}
+          password: ${{ secrets.GITHUB_TOKEN }}
+      # Authenticated Docker Hub pulls get a higher rate limit. This runs only when the owner has
+      # set the DOCKERHUB_USERNAME and DOCKERHUB_TOKEN repository secrets (a read-only token); forks
+      # and Dependabot runs do not receive them and skip it. Anonymous pulls still work, so a failed
+      # login must not fail the job before the pre-pull's own retries can run.
+      - name: Log in to Docker Hub (optional)
+        if: env.DOCKERHUB_USERNAME != ''
+        continue-on-error: true
+        uses: docker/login-action@v4
+        with:
+          username: ${{ env.DOCKERHUB_USERNAME }}
+          password: ${{ secrets.DOCKERHUB_TOKEN }}
       # Anonymous pulls from public.ecr.aws are rate limited per IP and hosted runners share IPs,
       # so `docker compose up` could fail with toomanyrequests before any test ran. The script
       # pre-pulls the stack's images so Compose finds them locally. The three Supabase images come
@@ -99,7 +126,7 @@ jobs:
       # public.ecr.aws names Compose uses, falling back to public.ecr.aws. The rest come from Docker
       # Hub. Each image gets up to six attempts with growing backoff. The list is read from the
       # Compose file and Dockerfiles, so Dependabot bumps need no edit here, and it includes the
-      # BuildKit `# syntax=` frontend.
+      # BuildKit `# syntax=` frontend. The logins above make the pulls authenticated where possible.
       - run: bash scripts/ci-prepull-images.sh
       # Exactly the local command: Playwright's global setup builds and starts the stack from an
       # empty database, and its teardown drops it (Engineering Practices, "E2E environment").
