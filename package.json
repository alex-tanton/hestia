{
  "name": "hearth",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm -r --if-present test:integration",
    "test:sweep": "node scripts/test-sweep.mjs",
    "test:sweep:integration": "node scripts/test-sweep.mjs --suite integration",
    "db:types": "pnpm --filter @hearth/service db:types",
    "db:seed": "pnpm --filter @hearth/service db:seed",
    "fixtures:normalize": "pnpm --filter @hearth/service fixtures:normalize",
    "test:e2e": "pnpm --filter @hearth/e2e test:e2e",
    "build": "pnpm -r --if-present build",
    "knip": "knip",
    "knip:production": "knip --production --workspace \"!e2e\" --workspace \"!supabase/seed\""
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "knip": "6.41.0",
    "lint-staged": "17.5.1",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.2"
    }
  }
}
