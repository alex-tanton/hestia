diff --git a/scripts/deploy.test.mjs b/scripts/deploy.test.mjs
new file mode 100644
index 0000000..818c7f8
--- /dev/null
+++ b/scripts/deploy.test.mjs
@@ -0,0 +1,148 @@
+/*
+ * Tests for `scripts/deploy.sh`: that the database password never appears on the command line of
+ * anything the script runs (a process list, `set -x` and CI logs all show argv). The real script
+ * runs to the end against stub `docker`, `supabase` and `curl` binaries put first on `PATH`; each
+ * stub appends its argv, and the password variable it was given, to a log the test reads. Nothing
+ * here starts a container or touches a database. Run by `pnpm test` through the root
+ * `test:harness` script.
+ */
+
+import assert from 'node:assert/strict';
+import { spawnSync } from 'node:child_process';
+import {
+  chmodSync,
+  mkdirSync,
+  mkdtempSync,
+  readFileSync,
+  rmSync,
+  symlinkSync,
+  writeFileSync,
+} from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join, resolve } from 'node:path';
+import { after, describe, it } from 'node:test';
+
+const REPO_ROOT = resolve(import.meta.dirname, '..');
+const DEPLOY = join(REPO_ROOT, 'scripts', 'deploy.sh');
+const SHA = '0123456789abcdef0123456789abcdef01234567';
+
+const scratch = mkdtempSync(join(tmpdir(), 'hearth-deploy-'));
+after(() => {
+  rmSync(scratch, { recursive: true, force: true });
+});
+
+// Answers the few queries deploy.sh makes and logs everything: "<name>\t<arg>\t<arg>..." then
+// "ENV\t<name>\tPGPASSWORD=<value or <unset>>". Anything else succeeds silently.
+const STUB = `#!/usr/bin/env bash
+name="$(basename "$0")"
+{
+  printf '%s' "$name"
+  for arg in "$@"; do printf '\\t%s' "$arg"; done
+  printf '\\n'
+  printf 'ENV\\t%s\\tPGPASSWORD=%s\\n' "$name" "\${PGPASSWORD-<unset>}"
+} >> "$STUB_LOG"
+if [[ "$name" == docker ]]; then
+  case "$*" in
+    "image inspect --format {{.Id}} "*) echo "sha256:stub" ;;
+    *"ps --quiet db"*) echo "db-container" ;;
+    "inspect --format "*) echo "172.16.238.5" ;;
+  esac
+fi
+exit 0
+`;
+
+/** Runs deploy.sh with `password` as POSTGRES_PASSWORD; returns the script's result and the stub log. */
+function deploy(password) {
+  const directory = mkdtempSync(join(scratch, 'run-'));
+  const bin = join(directory, 'bin');
+  mkdirSync(bin);
+  writeFileSync(join(directory, 'stub.sh'), STUB);
+  chmodSync(join(directory, 'stub.sh'), 0o755);
+  for (const name of ['docker', 'supabase', 'curl'])
+    symlinkSync(join(directory, 'stub.sh'), join(bin, name));
+  const envFile = join(directory, 'env');
+  writeFileSync(envFile, `POSTGRES_PASSWORD=${password}\nHEARTH_SERVICE_DB_PASSWORD=other\n`);
+  const log = join(directory, 'log');
+  writeFileSync(log, '');
+
+  const environment = Object.fromEntries(
+    Object.entries(process.env).filter(([key]) => key !== 'PGPASSWORD'),
+  );
+  const run = spawnSync('bash', [DEPLOY], {
+    cwd: REPO_ROOT,
+    encoding: 'utf8',
+    env: {
+      ...environment,
+      PATH: `${bin}:${process.env['PATH'] ?? ''}`,
+      HEARTH_ENV_FILE: envFile,
+      HEARTH_DEPLOY_SHA: SHA,
+      STUB_LOG: log,
+    },
+  });
+  const lines = readFileSync(log, 'utf8')
+    .split('\n')
+    .filter((line) => line !== '');
+  const calls = lines.filter((line) => !line.startsWith('ENV\t')).map((line) => line.split('\t'));
+  const envs = lines.filter((line) => line.startsWith('ENV\t')).map((line) => line.split('\t'));
+  return { run, calls, envs };
+}
+
+describe('deploy.sh: the database password', () => {
+  const password = 'sentinel-Pw-9f3a7c1e5b2d';
+  const { run, calls, envs } = deploy(password);
+
+  it('runs to the end against the stubs', () => {
+    assert.equal(run.status, 0, `${run.stdout}\n${run.stderr}`);
+    // Without this the checks below could pass because the script never reached the step.
+    assert.ok(
+      calls.some((call) => call[0] === 'supabase' && call[1] === 'migration' && call[2] === 'up'),
+      'the migration step did not run',
+    );
+  });
+
+  it('is on no command line', () => {
+    for (const call of calls) {
+      assert.ok(
+        !call.join(' ').includes(password),
+        `argv of ${call[0]} holds the password: ${call.join(' ')}`,
+      );
+    }
+  });
+
+  it('is not printed by the script either', () => {
+    assert.ok(!run.stdout.includes(password) && !run.stderr.includes(password));
+  });
+
+  it('reaches the migration command through its environment, and nothing else', () => {
+    const migration = calls.findIndex((call) => call[0] === 'supabase' && call[2] === 'up');
+    const supabaseEnvs = envs.filter((entry) => entry[1] === 'supabase');
+    assert.ok(migration >= 0);
+    assert.deepEqual(
+      supabaseEnvs.map((entry) => entry[2]),
+      [`PGPASSWORD=${password}`],
+    );
+    const others = envs.filter((entry) => entry[1] !== 'supabase');
+    assert.ok(others.length > 0);
+    for (const entry of others) assert.equal(entry[2], 'PGPASSWORD=<unset>', `${entry[1]} saw it`);
+  });
+
+  it('leaves the connection string as user and host only', () => {
+    const call = calls.find((entry) => entry[0] === 'supabase' && entry[2] === 'up') ?? [];
+    const url = new URL(call[call.indexOf('--db-url') + 1] ?? '');
+    assert.equal(url.username, 'postgres');
+    assert.equal(url.password, '');
+    assert.equal(url.host, '172.16.238.5:5432');
+  });
+});
+
+describe('deploy.sh: a password with URL-reserved characters', () => {
+  it('arrives intact, which a password inside a URL would not', () => {
+    const password = 'p@ss/w:rd#1?x%y';
+    const { run, envs } = deploy(password);
+    assert.equal(run.status, 0, `${run.stdout}\n${run.stderr}`);
+    assert.deepEqual(
+      envs.filter((entry) => entry[1] === 'supabase').map((entry) => entry[2]),
+      [`PGPASSWORD=${password}`],
+    );
+  });
+});
