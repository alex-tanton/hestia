# Hestia Configuration Template (.env)
# Production configuration lives outside the repository at /srv/hestia/.env.
# Run scripts/generate-secrets.sh to populate secrets, then supply the values below.

# Public origin for the application and links (must match Cloudflare DNS)
HESTIA_ORIGIN=https://hestia.aberrance.app

# Cloudflare Zero Trust tunnel token for routing external traffic to Caddy
CLOUDFLARE_TUNNEL_TOKEN=

# Server owner email (grants access to deep system health diagnostics)
HESTIA_OWNER_EMAIL=owner@example.com

# Feature Flags
# Enables passwordless magic link email authentication (injected into web build as VITE_MAGIC_LINK_ENABLED)
HESTIA_MAGIC_LINK_ENABLED=true

# GoTrue SMTP Settings (Resend transactional email delivery)
GOTRUE_SMTP_HOST=smtp.resend.com
GOTRUE_SMTP_PORT=465
GOTRUE_SMTP_USER=resend
GOTRUE_SMTP_PASS=
GOTRUE_SMTP_ADMIN_EMAIL=auth@aberrance.app
GOTRUE_SMTP_SENDER_NAME=Hestia

# Backup destination path on secondary physical storage (mounted into backup container)
BACKUP_DIR=/mnt/backup/hestia

# Rate limiting (optional per-IP limit across /api/* endpoints, default: 300 req/min)
# HESTIA_RATE_LIMIT_PER_MINUTE=300

# --- Secrets automatically generated by scripts/generate-secrets.sh ---
POSTGRES_PASSWORD=<generated>
HESTIA_SERVICE_DB_PASSWORD=<generated>
JWT_SECRET=<generated>
ANON_KEY=<generated>
SERVICE_ROLE_KEY=<generated>
REALTIME_SECRET_KEY_BASE=<generated>
REALTIME_DB_ENC_KEY=<generated>

# Web Push VAPID keys (RFC 8292 compliant browser push notifications)
VAPID_PUBLIC_KEY=<generated>
VAPID_PRIVATE_KEY=<generated>
VAPID_SUBJECT=mailto:admin@aberrance.app
